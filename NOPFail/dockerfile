# Start from an older, more permissive version of Ubuntu
FROM ubuntu:16.04

# Avoid interactive prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install all the tools we need: compilers, nasm, gdb, and python
RUN apt-get update && apt-get install -y \
    build-essential \
    nasm \
    gdb \
    python \
    && rm -rf /var/lib/apt/lists/*

# Create a non-root user to work as
RUN useradd -m -s /bin/bash user
USER user
WORKDIR /home/user

# Copy all of our local files (sled_asm.s, exploit.py) into the container
COPY --chown=user:user . .
